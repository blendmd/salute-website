# お問い合わせフォーム（/api/contact）用 — コピーして .env.local を作成し値を入れてください。
# Vercel では Settings → Environment Variables に同じ名前で登録します。

# ロリポップ SMTP（例）
SMTP_HOST=smtp.lolipop.jp
# 587 = STARTTLS（推奨） / 465 = SSL のときは下の SMTP_SECURE=true
SMTP_PORT=587
SMTP_USER=info@salute-ai.com
SMTP_PASS=メールボックスのパスワード

# 465 + SSL を使う場合
# SMTP_PORT=465
# SMTP_SECURE=true

# 受信先（問い合わせが届くアドレス）
CONTACT_TO=info@salute-ai.com

# 送信元（From）。ロリポップでは多くの場合、SMTP_USER と同じメールアドレスにする
CONTACT_FROM=info@salute-ai.com
